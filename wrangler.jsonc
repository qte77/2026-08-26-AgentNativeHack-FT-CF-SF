{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-native-hack",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true
  },
  "vars": {
    "TARGET_REPO_OWNER": "qte77",
    "TARGET_REPO_NAME": "2026-08-26-AgentNativeHack-FT-CF-SF",
    "AISA_MODEL": "qwen-flash"
  },
  "kv_namespaces": [
    {
      "binding": "CHECKPOINTS",
      "id": "local-dev-checkpoints"
    }
  ]
}
